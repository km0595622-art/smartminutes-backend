<header><h2>SmartMinute</h2><button class="back" onclick="goBack()">
← Dashboard
</button></header><div class="container"><div class="box"><h1>💳 Deposit</h1><p class="subtitle">
Add money to your SmartMinute account
</p><div class="balance">Current Balance

<strong>KSh 0.00</strong>

</div><form id="depositForm"><label>
Deposit Amount
</label><div class="amount-options"><button type="button" onclick="setAmount(50)">
KSh 50
</button><button type="button" onclick="setAmount(100)">
KSh 100
</button><button type="button" onclick="setAmount(200)">
KSh 200
</button><button type="button" onclick="setAmount(500)">
KSh 500
</button></div><p class="minimum">
Minimum deposit: KSh 50
</p><input
id="amount"
type="number"
min="50"
placeholder="Or enter your own amount"
required

«»

<label for="phone">
M-Pesa Phone Number
</label><input
id="phone"
type="tel"
placeholder="07XXXXXXXX"
required

«»

<button
id="depositButton"
class="deposit-button"
type="submit"

«»

💳 Continue Deposit
</button>

</form><p id="message"></p><div class="note"><strong>Important:</strong><br>

Your money will only be deposited after the payment is successfully confirmed.

The M-Pesa payment connection will be connected after we successfully test this deposit request.

</div></div></div><script>

/*
==================================================
SMARTMINUTE DEPOSIT
==================================================
*/

const token = localStorage.getItem("token");

if(!token){

    window.location.href = "login.html";

}


/*
==================================================
BACKEND URL
==================================================
*/

const API_URL = "https://smartminutes-backend.onrender.com";


/*
==================================================
SELECT AMOUNT
==================================================
*/

function setAmount(amount){

    document.getElementById("amount").value = amount;

    document.getElementById("message").textContent = "";

}


/*
==================================================
DEPOSIT FORM
==================================================
*/

const form = document.getElementById("depositForm");

const message = document.getElementById("message");

const depositButton =
    document.getElementById("depositButton");


form.addEventListener("submit", async function(e){

    e.preventDefault();


    const amount =
        Number(document.getElementById("amount").value);

    const phone =
        document.getElementById("phone").value.trim();


    /*
    ==============================================
    MINIMUM DEPOSIT
    ==============================================
    */

    if(amount < 50){

        message.textContent =
        "Minimum deposit is KSh 50.";

        message.style.color = "red";

        return;

    }


    /*
    ==============================================
    PHONE CHECK
    ==============================================
    */

    if(!/^07\d{8}$/.test(phone)){

        message.textContent =
        "Please enter a valid M-Pesa number, e.g. 0712345678.";

        message.style.color = "red";

        return;

    }


    /*
    ==============================================
    SHOW LOADING
    ==============================================
    */

    depositButton.disabled = true;

    depositButton.textContent = "Processing...";

    message.textContent =
        "Sending deposit request...";

    message.style.color = "#0066ff";


    /*
    ==============================================
    SEND REQUEST TO EXPRESS BACKEND
    ==============================================
    */

    try{

        const response = await fetch(
            `${API_URL}/api/deposit`,
            {
                method:"POST",

                headers:{
                    "Content-Type":"application/json",

                    "Authorization":
                        `Bearer ${token}`
                },

                body:JSON.stringify({

                    amount:amount,

                    phone:phone

                })

            }
        );


        /*
        ==========================================
        READ BACKEND RESPONSE
        ==========================================
        */

        const data = await response.json();


        /*
        ==========================================
        SUCCESS
        ==========================================
        */

        if(response.ok){

            message.textContent =
                data.message ||
                "Deposit request submitted successfully. 💳";

            message.style.color = "green";


            /*
            Clear the form after successful request
            */

            document.getElementById("amount").value = "";

            document.getElementById("phone").value = "";


        }else{

            /*
            ======================================
            BACKEND ERROR
            ======================================
            */

            message.textContent =
                data.message ||
                "Deposit request failed.";

            message.style.color = "red";

        }


    }catch(error){

        console.error("DEPOSIT ERROR:",error);


        message.textContent =
            "Unable to connect to the SmartMinute server. Please try again.";

        message.style.color = "red";

    }


    /*
    ==============================================
    ENABLE BUTTON AGAIN
    ==============================================
    */

    depositButton.disabled = false;

    depositButton.textContent =
        "💳 Continue Deposit";

});


/*
==================================================
BACK TO DASHBOARD
==================================================
*/

function goBack(){

    window.location.href = "dashboard.html";

}

</script></body>
